# SAVORIA — Backend Configuration Environment Variables Template

PORT=3000
NODE_ENV=development

# MongoDB Connection String (Local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/savoria

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Restaurant Admin & Owner Email
ADMIN_EMAIL=owner@savoria-dining.com
ADMIN_PHONE=+91 98765 43210

# Custom SMTP Credentials (Optional - Ethereal test mail is auto-generated if left blank)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
